{
  "projectName": "joeonthesoundweb",
  "buildConfig": {
    "buildCommand": "node scripts/build.mjs",
    "outputDirectory": "dist",
    "deployCommand": "wrangler deploy",
    "nodeVersion": "24.16.0"
  },
  "pages": {
    "productionBranch": "main",
    "previewBranches": ["develop", "staging"],
    "deployments": {
      "production": {
        "branch": "main",
        "command": "node scripts/build.mjs && wrangler deploy --env production",
        "environment": "production",
        "routes": {
          "pattern": "joeonthesoundweb.com",
          "zoneId": "YOUR_ZONE_ID_HERE"
        }
      },
      "preview": {
        "command": "node scripts/build.mjs && wrangler deploy --env preview",
        "environment": "preview"
      }
    }
  },
  "environmentVariables": {
    "required": [
      {
        "name": "APIVIDEO",
        "description": "API Video access token",
        "scope": ["production", "preview"],
        "placeholder": "your_api_video_token_here"
      },
      {
        "name": "AppPagoJoeontheSoundWebClientID",
        "description": "AppPago Client ID for payments",
        "scope": ["production", "preview"],
        "placeholder": "your_client_id_here"
      },
      {
        "name": "logo",
        "description": "URL or path to logo image",
        "scope": ["production", "preview"],
        "default": "logo.png",
        "optional": true
      }
    ]
  },
  "cloudflareSettings": {
    "compatibility_date": "2026-06-23",
    "compatibility_flags": [],
    "routes": [
      {
        "pattern": "joeonthesoundweb.com/*",
        "zone_name": "joeonthesoundweb.com",
        "custom_domain": true
      },
      {
        "pattern": "preview.joeonthesoundweb.com/*",
        "zone_name": "joeonthesoundweb.com",
        "environment": "preview"
      }
    ],
    "assets": {
      "directory": "dist",
      "not_found_handling": "single-page-application",
      "cache_control": {
        "default": "public, max-age=3600",
        "html": "public, max-age=300",
        "js": "public, max-age=86400",
        "css": "public, max-age=86400",
        "images": "public, max-age=604800"
      }
    }
  },
  "redirects": [
    {
      "from": "/es",
      "to": "/",
      "status": 302,
      "description": "Spanish locale redirect"
    }
  ],
  "headers": [
    {
      "path": "/api/*",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, POST, OPTIONS",
        "Content-Type": "application/json"
      }
    },
    {
      "path": "/*",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "SAMEORIGIN",
        "X-XSS-Protection": "1; mode=block",
        "Referrer-Policy": "strict-origin-when-cross-origin"
      }
    }
  ],
  "monitoring": {
    "analytics": true,
    "errorReporting": true,
    "performance": {
      "trackingEnabled": true,
      "slowRequestThreshold": 3000
    }
  },
  "deployment": {
    "previewUrl": "https://[commit-hash].preview.joeonthesoundweb.com",
    "productionUrl": "https://joeonthesoundweb.com",
    "rollbackEnabled": true,
    "maxPreviousDeployments": 10
  }
}
